pipeline {
    agent any

    environment {
        DB_URL = "jdbc:mysql://localhost:3306/hospital_db"
        DB_USER = "root"
        DB_PASS = "root"
    }

    stages {
        stage('Checkout') {
            steps {
                echo '📦 Checking out source code...'
                git branch: 'main', url: 'https://github.com/Madireddysaikrishna/hospital-managment-system.git'
            }
        }

        stage('Build') {
            steps {
                echo '🔨 Building Spring Boot project...'
                bat 'mvn clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                echo '🧪 Running unit tests...'
                bat 'mvn test'
            }
        }

        stage('Package') {
            steps {
                echo '📦 Listing generated files...'
                bat 'dir target'
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 Deploying Spring Boot app...'
                bat 'java -jar target\\*.jar --server.port=8081'
            }
        }
    }

    post {
        success {
            echo '✅ Backend pipeline completed successfully!'
        }
        failure {
            echo '❌ Build or deployment failed!'
        }
    }
}
